server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # If another proxy/load balancer sits IN FRONT of this nginx (Render, a cloud LB, a CDN),
    # $remote_addr is that proxy, not the visitor. Name its address range in REAL_IP_FROM and
    # nginx takes the real visitor from X-Forwarded-For, but only when the request really came
    # from that range. The default (127.0.0.1) trusts nobody, which is right when clients
    # connect to this nginx directly (docker compose). Use a single CIDR; for several, add more
    # `set_real_ip_from` lines here. Never use 0.0.0.0/0: any client could then pick its address.
    set_real_ip_from ${REAL_IP_FROM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/javascript image/svg+xml;
    gzip_min_length 1024;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri =404;
    }

    # Health check endpoint
    location = /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Tells the browser where the backend lives so it can wake it directly. On Render's
    # free tier a sleeping backend is NOT woken by this proxy (Render answers a request
    # from another Render service with an instant 502); only a request from outside Render
    # starts it. See docs/adr/009-cold-start-handling.md.
    location = /runtime-config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        include /etc/nginx/conf.d/security-headers.inc;
        return 200 '{"backendUrl":"${BACKEND_URL}"}';
    }

    # Proxy API calls to the backend. ${BACKEND_URL} is substituted at
    # container start (nginx:1.27's built-in envsubst-on-templates entrypoint
    # step — see /docker-entrypoint.d/20-envsubst-on-templates.sh in the base
    # image), not baked in at build time. Default is set via ENV in the
    # Dockerfile (http://backend:8000, the docker-compose service name) —
    # override it per-deployment with a runtime env var, no rebuild needed.
    # This was missing entirely before, which is why POST /api/v1/auth/login
    # (and every other API call) fell through to the SPA catch-all below and
    # got rejected with 405 by nginx's static file handler (GET/HEAD only on
    # a resolved file like index.html).
    location /api/ {
        # Attachments are capped at 10 MB by the API; leave headroom for multipart overhead.
        client_max_body_size 11m;

        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;

        # A sleeping Render backend can take a minute or more to wake up. Wait for it
        # rather than failing with 504 at nginx's 60 s defaults; the SPA retries too
        # (src/api/coldStart.ts), this just stops nginx giving up first.
        proxy_connect_timeout 90s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # Send SNI so Render's edge can complete the TLS handshake.
        proxy_ssl_server_name on;

        # Use the backend hostname selected by proxy_pass instead of the frontend host.
        proxy_set_header Host $proxy_host;
        # The backend reads the visitor's address from the END of X-Forwarded-For, which is
        # the part this line appends ($remote_addr: the real client after the real_ip step
        # above). Anything the client sent itself stays to the left and is never trusted.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Render terminates TLS before nginx, so the scheme is present in this header.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # React SPA — all routes fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/security-headers.inc;
    }
}