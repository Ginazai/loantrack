# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.env
*.egg-info/
dist/
build/

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# ── Vite ─────────────────────────────────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── Database ──────────────────────────────────────────────────────────────────
*.sqlite
*.db
*.db-shm
*.db-wal
postgres-data/

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep docker-compose files tracked; ignore local overrides
docker-compose.override.yml

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS & Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# ── Alembic ───────────────────────────────────────────────────────────────────
# Track migrations but ignore any local autogenerated junk
alembic/__pycache__/
