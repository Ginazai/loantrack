# docker-compose environment — feeds `docker compose up` (docker-compose.yml
# reads a .env file from its own directory only, which is this one).
#
# Running a service directly instead, without Docker? Use its own dedicated
# file: backend/.env.example or frontend/.env.example — this file overlaps
# with both on purpose (docker-compose passes most of this straight into
# each container's environment) but is the one that actually matters here.
#
# Copy this file to `.env` in the repo root and adjust as needed:
#   cp .env.example .env

# ── Database (shared by db, backend, and seed) ────────────────────────────────
POSTGRES_DB=interests_db
POSTGRES_USER=loantrack
POSTGRES_PASSWORD=change-me

# ── Backend application ────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=false
LOG_LEVEL=INFO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
UVICORN_WORKERS=2

# Note: ALLOWED_ORIGINS isn't listed here — docker-compose hardcodes it to
# ["http://localhost"] directly in docker-compose.yml (the frontend's only
# origin in this topology), not read from .env.

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# ── Webhooks (payment.added, cycle.closed, etc.) ──────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_SECONDS=60
# How often the in-process cycle-close scan runs (ADR-006) — an asyncio task
# in the FastAPI lifespan, not a separate worker/queue.
CYCLE_SCAN_INTERVAL_SECONDS=3600

# ── Frontend / nginx ────────────────────────────────────────────────────────────
# Where the frontend's nginx proxies /api/* to, substituted at container
# start (not baked into the image). "http://backend:8000" resolves via
# Docker's embedded DNS since both services share this compose file's
# network — leave it as-is unless frontend and backend are ever deployed on
# separate hosts/platforms. No rebuild needed either way.
BACKEND_URL=http://backend:8000

# ── Ports (host-side, i.e. what you open in a browser) ────────────────────────
APP_PORT=80
DB_EXPOSE_PORT=5432
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@loantrack.dev
PGADMIN_PASSWORD=admin

# ── Seed (docker compose run --rm seed — creates this admin user once) ────────
SEED_ADMIN_EMAIL=admin@loantrack.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin User
