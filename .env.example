# ── Application ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=interests_db
POSTGRES_USER=loantrack
POSTGRES_PASSWORD=change-me

# ── Auth tokens ───────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_SECONDS=60

# ── App / ports ───────────────────────────────────────────────────────────────
APP_PORT=80
DB_EXPOSE_PORT=5432
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@loantrack.dev
PGADMIN_PASSWORD=admin

# ── Seed ──────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@loantrack.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin User

# ── Frontend (Vite — local dev only, not used in Docker) ─────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
