# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=interests_db
POSTGRES_USER=loantrack
POSTGRES_PASSWORD=change_this_strong_password

# Expose postgres to host on this port (useful for dev tools like TablePlus)
# Remove the db.ports section from docker-compose.yml in production
DB_EXPOSE_PORT=5432

# ── Backend ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_string_in_production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DEBUG=false
LOG_LEVEL=info
UVICORN_WORKERS=2

RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_SECONDS=60

# ── Frontend ──────────────────────────────────────────────────────────────────
APP_PORT=80

# ── pgAdmin ───────────────────────────────────────────────────────────────────
# Access at http://localhost:PGADMIN_PORT  (default: http://localhost:5050)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@loantrack.dev
PGADMIN_PASSWORD=admin

# ── Seed script ───────────────────────────────────────────────────────────────
# Used by:  docker compose run --rm seed
SEED_ADMIN_EMAIL=admin@loantrack.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin User
