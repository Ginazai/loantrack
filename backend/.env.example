# Backend (FastAPI) environment — for running the backend directly, outside
# docker-compose: `uvicorn app.main:app`, pytest, alembic, scripts/seed.py.
#
# Running via `docker compose up` instead? These same values are already
# wired into ../docker-compose.yml's `backend:` service from the repo-root
# .env file — copy ../.env.example to ../.env and edit there, not here.
# (docker-compose does not read this file.)
#
# Every variable below matches a field in app/core/config.py::Settings
# unless a comment says otherwise. Copy this file to `.env` in this
# directory and adjust as needed:  cp .env.example .env

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Interests Calculator"
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────────────────
# A full connection string, not split into host/user/password — point this at
# any reachable Postgres (local, Docker, or managed/Supabase).
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interests_db

# ── Auth tokens ───────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. Under docker-compose this is hardcoded to
# ["http://localhost"] in docker-compose.yml instead of read from .env —
# only relevant here for standalone/local runs (e.g. against a local Vite
# dev server on :5173).
ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# ── Webhooks (payment.added, cycle.closed, etc.) ──────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_SECONDS=60

# How often the in-process cycle-close scan runs (ADR-006) — an asyncio task
# in the FastAPI lifespan, not a separate worker/queue.
CYCLE_SCAN_INTERVAL_SECONDS=3600

# ── Seed (scripts/seed.py — creates this admin user on first boot only) ───────
SEED_ADMIN_EMAIL=admin@loantrack.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin User

# ── Container runtime (read directly by entrypoint.sh, not by Settings) ───────
# Only relevant when actually running via Docker (building/running this
# service's image outside docker-compose); ignored by `uvicorn` run directly.
PORT=8000
UVICORN_WORKERS=2
